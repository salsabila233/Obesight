# ObeSight - Environment Variables Configuration
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi SMTP Anda.

# Konfigurasi SMTP Pengiriman Email (Contoh: Google Gmail)
# Jika menggunakan Gmail: aktifkan 2-Step Verification di Google Account,
# lalu buat "App Password" (Sandi Aplikasi) di menu Keamanan Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=emailanda@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="ObeSight Official" <no-reply@obesight.com>

# Catatan: Jika SMTP belum dikonfigurasi di file .env, server otomatis berjalan dalam
# Mode Simulasi Pengembang (Dev Mode): kode OTP akan dicetak di terminal dan notifikasi demo.
