// ============================================================================
// SECURITY RULES LENGKAP CLOUD FIRESTORE OBESIGHT
// Salin seluruh isi file ini dan tempelkan (Paste) ke tab Rules di Firebase Console
// atau deploy via: firebase deploy --only firestore:rules
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Profil Pengguna & Data Pribadi (Sub-Koleksinya)
    match /users/{userId} {
      // Pemilik akun dapat membaca dan memperbarui profilnya sendiri
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-koleksi Catatan Pelacakan Tidur (Sleep Records)
      match /sleep_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sub-koleksi Catatan Progress Nutrisi (Makanan & Minuman Harian)
      match /nutrition_progress/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sub-koleksi Hasil & Riwayat Skrining Obesitas (Screening Sessions)
      match /screenings/{screeningId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Koleksi Utama: Progress Nutrisi & Makanan
    match /nutrition_progress/{docId} {
      allow read, write: if request.auth != null;
    }

    // 3. Katalog Menu Master (Hanya Baca)
    match /nutrition_meals/{mealId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 4. Koleksi Utama: Progress Aktivitas Fisik & Riwayat Sesi
    // Dokumen utama per pengguna diidentifikasi menggunakan namaPengguna (dengan validasi idPengguna)
    match /progress_aktivitas_fisik/{namaPengguna} {
      // Pengguna hanya dapat membaca dan memodifikasi dokumen miliknya sendiri
      allow read: if request.auth != null && (resource == null || resource.data.idPengguna == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.idPengguna == request.auth.uid;
      allow update: if request.auth != null 
                    && (resource == null || resource.data.idPengguna == request.auth.uid) 
                    && request.resource.data.idPengguna == request.auth.uid;
      allow delete: if request.auth != null && resource.data.idPengguna == request.auth.uid;

      // Sub-koleksi: Riwayat Sesi Olahraga
      match /riwayat_sesi/{sessionId} {
        allow read: if request.auth != null && (resource == null || resource.data.idPengguna == request.auth.uid);
        allow create: if request.auth != null && request.resource.data.idPengguna == request.auth.uid;
        allow update: if request.auth != null 
                      && (resource == null || resource.data.idPengguna == request.auth.uid) 
                      && request.resource.data.idPengguna == request.auth.uid;
        allow delete: if request.auth != null && resource.data.idPengguna == request.auth.uid;
      }
    }

    // 5. Kalkulator IMT
    match /kalkulator_imt/{calcId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.idPengguna == request.auth.uid);
    }

    // 6. Koleksi Artikel Kesehatan (Hanya Baca)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // 7. Antrean Kirim Email Otomatis (Firebase Trigger Email)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // 8. Verifikasi OTP Pendaftaran & Lupa Sandi
    match /otp_verifications/{email} {
      allow read, write: if true;
    }
  }
}
