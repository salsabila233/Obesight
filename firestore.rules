rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Profil Pengguna & Sub-Koleksinya
    match /users/{userId} {
      // Pemilik akun dapat membaca dan memperbarui profilnya sendiri
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-koleksi Catatan Progress Nutrisi (Makanan & Minuman Harian)
      match /nutrition_progress/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sub-koleksi Catatan Pelacakan Tidur (Sleep Records)
      match /sleep_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Progress Makanan & Minuman (Sub-koleksi per Pengguna)
      match /nutrition_progress/{dateKey} {
      // Sub-koleksi Hasil & Riwayat Skrining Obesitas (Screening Sessions)
      match /screenings/{screeningId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

