// ============================================================================
// SECURITY RULES LENGKAP CLOUD FIRESTORE OBESIGHT
// Salin seluruh isi file ini dan tempelkan (Paste) ke tab Rules di Firebase Console
// atau deploy via: firebase deploy --only firestore:rules
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Profil Pengguna & Data Pribadi
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Catatan Tidur
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Aturan Dokumen Profil Pengguna & Sub-Koleksinya
    match /users/{userId} {
      // Pemilik akun dapat membaca dan memperbarui profilnya sendiri
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-koleksi Catatan Progress Nutrisi (Makanan & Minuman Harian)
      match /nutrition_progress/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sub-koleksi Catatan Pelacakan Tidur (Sleep Records)
      match /sleep_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Progress Makanan & Minuman (Sub-koleksi per Pengguna)
      match /nutrition_progress/{dateKey} {
      // Sub-koleksi Hasil & Riwayat Skrining Obesitas (Screening Sessions)
      match /screenings/{screeningId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Koleksi Utama: Progress Makanan & Minuman (Muncul di Panel Kiri Console)
    match /nutrition_progress/{docId} {
      allow read, write: if request.auth != null;
    }

    // 3. Katalog Menu Master (Hanya Baca)
    match /nutrition_meals/{mealId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 4. Layanan OTP & Email
    match /otp_verifications/{email} {
      allow read, write: if true;
    }

    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // 5. Koleksi Artikel Kesehatan (RULES FINAL)
    match /articles/{articleId} {
      // Hanya artikel yang sudah berstatus terbit (isPublished == true) yang dapat dibaca aplikasi
      allow read: if resource.data.isPublished == true;
      // Penulisan/pengeditan/penghapusan dari client ditolak (hanya diizinkan via Firebase Console oleh admin)
      allow write: if false;
    }
    // Antrean Kirim Email Otomatis (Firebase Trigger Email)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: false;
    }

    // Verifikasi OTP Pendaftaran & Lupa Sandi
    match /otp_verifications/{email} {
      allow read, write: if true;
    }
  }
}
