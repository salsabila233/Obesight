rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Aturan Dokumen Profil Pengguna & Sub-Koleksinya
    match /users/{userId} {
      // Pemilik akun dapat membaca dan memperbarui profilnya sendiri
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-koleksi Catatan Progress Nutrisi (Makanan & Minuman Harian)
      match /nutrition_progress/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sub-koleksi Catatan Pelacakan Tidur (Sleep Records)
      match /sleep_records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sub-koleksi Hasil & Riwayat Skrining Obesitas (Screening Sessions)
      match /screenings/{screeningId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Antrean Kirim Email Otomatis (Firebase Trigger Email)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: false;
    }

    // Verifikasi OTP Pendaftaran & Lupa Sandi
    match /otp_verifications/{email} {
      allow read, write: if true;
    }
  }
}
